{
  "description": "Oracle 19c smoke test on RDS (SE2 19): TPC-C scale 32 and YCSB A at 1M rows, READ COMMITTED, both layouts, the fast network, one repetition: the harness, the setup and the server stats on 19c, and a first ratio",
  "workloads": {
    "tpcc": {
      "benchmark": "tpcc",
      "scale": 32
    },
    "ycsb-a": {
      "benchmark": "ycsb",
      "weights": "50,0,0,50,0,0",
      "scale": 1000
    }
  },
  "matrix": {
    "workloads": [
      "tpcc",
      "ycsb-a"
    ],
    "levels": [
      "READ_COMMITTED"
    ],
    "layouts": [
      "decoupled",
      "inline"
    ],
    "delays_us": [
      0
    ]
  },
  "runs": "a,c",
  "reps": 1,
  "time_s": 60,
  "terminals": 4,
  "loader_threads": 8,
  "jvm_args": [
    "-Doracle.jdbc.implicitStatementCacheSize=128"
  ]
}
