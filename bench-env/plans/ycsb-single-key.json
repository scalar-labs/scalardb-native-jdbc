{
  "description": "YCSB's standard mixes at 1M rows: A read/update, C read, E scan/insert, F read/read-modify-write; both levels, both layouts, the fast network",
  "workloads": {
    "ycsb-a": {"benchmark": "ycsb", "weights": "50,0,0,50,0,0", "scale": 1000},
    "ycsb-c": {"benchmark": "ycsb", "weights": "100,0,0,0,0,0", "scale": 1000},
    "ycsb-e": {"benchmark": "ycsb", "weights": "0,5,95,0,0,0", "scale": 1000},
    "ycsb-f": {"benchmark": "ycsb", "weights": "50,0,0,0,0,50", "scale": 1000}
  },
  "matrix": {
    "workloads": ["ycsb-a", "ycsb-c", "ycsb-e", "ycsb-f"],
    "levels": ["READ_COMMITTED", "SNAPSHOT"],
    "layouts": ["decoupled", "inline"],
    "delays_us": [0]
  },
  "runs": "a,c",
  "reps": 2,
  "time_s": 120,
  "terminals": 4,
  "loader_threads": 8,
  "jvm_args": ["-Doracle.jdbc.implicitStatementCacheSize=128"]
}
