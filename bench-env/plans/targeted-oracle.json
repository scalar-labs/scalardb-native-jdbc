{
  "description": "Targeted, Oracle: the slow results the five fixes aim at, TPC-C scale 32 and YCSB E at 1M rows, both levels and layouts, the fast network",
  "workloads": {
    "tpcc": {
      "benchmark": "tpcc",
      "scale": 32
    },
    "ycsb-e": {
      "benchmark": "ycsb",
      "weights": "0,5,95,0,0,0",
      "scale": 1000
    }
  },
  "matrix": {
    "workloads": [
      "tpcc",
      "ycsb-e"
    ],
    "levels": [
      "READ_COMMITTED",
      "SNAPSHOT"
    ],
    "layouts": [
      "decoupled",
      "inline"
    ],
    "delays_us": [
      0
    ]
  },
  "runs": "a,c",
  "reps": 2,
  "time_s": 60,
  "terminals": 4,
  "loader_threads": 8,
  "jvm_args": [
    "-Doracle.jdbc.implicitStatementCacheSize=128",
    "-XX:StartFlightRecording:settings=profile,jdk.CPUTimeSample#enabled=true,jdk.CPUTimeSample#throttle=1ms,filename={dir}/execute.jfr"
  ]
}
