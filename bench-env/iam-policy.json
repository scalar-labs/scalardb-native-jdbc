{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadInTheRegion",
      "Effect": "Allow",
      "Action": ["ec2:Describe*", "ec2:GetSecurityGroupsForVpc", "rds:Describe*", "rds:ListTagsForResource"],
      "Resource": "*",
      "Condition": { "StringEquals": { "aws:RequestedRegion": "us-east-1" } }
    },
    {
      "Sid": "ReadCostAndPrices",
      "Effect": "Allow",
      "Action": ["budgets:ViewBudget", "pricing:GetProducts", "ce:GetCostAndUsage"],
      "Resource": "*"
    },
    {
      "Sid": "CreateOnlyTagged",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateVpc", "ec2:CreateSubnet", "ec2:CreateInternetGateway", "ec2:CreateRouteTable",
        "ec2:CreateSecurityGroup", "ec2:ImportKeyPair", "ec2:RunInstances",
        "ec2:AuthorizeSecurityGroupIngress", "ec2:AuthorizeSecurityGroupEgress",
        "ec2:CreatePlacementGroup",
        "rds:CreateDBInstance", "rds:CreateDBSubnetGroup"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": { "aws:RequestTag/project": "scalardb-native-jdbc-bench", "aws:RequestedRegion": "us-east-1" }
      }
    },
    {
      "Sid": "TagOnlyWhileCreating",
      "Effect": "Allow",
      "Action": "ec2:CreateTags",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "ec2:CreateAction": [
            "CreateVpc", "CreateSubnet", "CreateInternetGateway", "CreateRouteTable",
            "CreateSecurityGroup", "ImportKeyPair", "RunInstances",
            "AuthorizeSecurityGroupIngress", "AuthorizeSecurityGroupEgress", "CreatePlacementGroup"
          ]
        }
      }
    },
    {
      "Sid": "RdsOnlyTheBenchTagOnBenchNames",
      "Effect": "Allow",
      "Action": "rds:AddTagsToResource",
      "Resource": ["arn:aws:rds:us-east-1:*:db:bench-b-*", "arn:aws:rds:us-east-1:*:subgrp:bench-*"],
      "Condition": {
        "StringEquals": { "aws:RequestTag/project": "scalardb-native-jdbc-bench" },
        "ForAllValues:StringEquals": { "aws:TagKeys": ["project"] }
      }
    },
    {
      "Sid": "ChangeAndDeleteOnlyTagged",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateSubnet", "ec2:CreateRouteTable", "ec2:CreateSecurityGroup", "ec2:CreateRoute",
        "ec2:RunInstances", "ec2:AttachInternetGateway", "ec2:DetachInternetGateway",
        "ec2:AssociateRouteTable", "ec2:DisassociateRouteTable", "ec2:ModifyVpcAttribute",
        "ec2:ModifySubnetAttribute", "ec2:ModifyInstanceAttribute",
        "ec2:AuthorizeSecurityGroupIngress", "ec2:AuthorizeSecurityGroupEgress",
        "ec2:RevokeSecurityGroupIngress", "ec2:RevokeSecurityGroupEgress",
        "ec2:StopInstances", "ec2:TerminateInstances", "ec2:DeleteRoute", "ec2:DeleteRouteTable",
        "ec2:DeleteSubnet", "ec2:DeleteInternetGateway", "ec2:DeleteSecurityGroup", "ec2:DeleteVpc",
        "ec2:DeleteKeyPair", "ec2:DeletePlacementGroup",
        "rds:CreateDBInstance", "rds:ModifyDBInstance", "rds:DeleteDBInstance",
        "rds:DeleteDBSubnetGroup", "rds:ModifyDBSubnetGroup"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": { "aws:ResourceTag/project": "scalardb-native-jdbc-bench", "aws:RequestedRegion": "us-east-1" }
      }
    },
    {
      "Sid": "WhatInstancesAndDatabasesReferenceOrCreateWithTheTaggedInstance",
      "Effect": "Allow",
      "Action": ["ec2:RunInstances", "rds:CreateDBInstance"],
      "Resource": [
        "arn:aws:ec2:us-east-1::image/*",
        "arn:aws:ec2:us-east-1:*:network-interface/*",
        "arn:aws:ec2:us-east-1:*:volume/*",
        "arn:aws:ec2:us-east-1:*:security-group-rule/*",
        "arn:aws:rds:us-east-1:*:pg:default.*",
        "arn:aws:rds:us-east-1:*:og:default:*"
      ]
    },
    {
      "Sid": "GiveTheClientItsRole",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::*:role/scalardb-bench-client",
      "Condition": { "StringEquals": { "iam:PassedToService": "ec2.amazonaws.com" } }
    },
    {
      "Sid": "FetchTheReports",
      "Effect": "Allow",
      "Action": ["s3:ListBucket", "s3:GetObject"],
      "Resource": ["arn:aws:s3:::scalardb-bench-*", "arn:aws:s3:::scalardb-bench-*/*"]
    },
    {
      "Sid": "RdsServiceRole",
      "Effect": "Allow",
      "Action": "iam:CreateServiceLinkedRole",
      "Resource": "arn:aws:iam::*:role/aws-service-role/rds.amazonaws.com/AWSServiceRoleForRDS",
      "Condition": { "StringLike": { "iam:AWSServiceName": "rds.amazonaws.com" } }
    }
  ]
}
