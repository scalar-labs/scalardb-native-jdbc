# Copy to bench.tfvars (ignored by git) and fill in. Secrets stay in this file, never in the chat.
admin_cidr     = "203.0.113.7/32"                 # your public address, /32
ssh_public_key = "ssh-ed25519 AAAA... you@host"   # the public key, not the private one
tier_a         = ["postgresql", "oracle"]
tier_b         = []                               # e.g. ["postgresql", "oracle"] for RDS
# Oracle on tier A: Oracle Free (2 CPUs, 2 GB, 12 GB of data) unless these name Enterprise Edition,
# an image from container-registry.oracle.com after accepting
# its licence there, and the registry login (an auth token, not the account password)
oracle_image          = ""
oracle_registry_user  = ""
oracle_registry_token = ""
# db_password comes from the environment: export BENCH_DB_PASSWORD=..., which run.sh passes on
# for runs without the laptop: the instance profile of setup-account.sh, with BENCH_BUCKET=scalardb-bench-<account>
client_profile = ""
# tier A: memory per database container (file cache included), e.g. 1536 for data read from disk; 0 for none
db_memory_mb = 0
# tier A PostgreSQL: pg_stat_statements loaded, for BenchBase's server statistics (BENCHBASE=1)
pg_stat_statements = false
