#!/bin/bash
# Tier A database: the engine's official image, host networking, the data on the instance's NVMe,
# the settings of docs/plans/benchmark-environment.md. Terminates itself after ${lifetime} minutes.
# With db_memory_mb the container may use that much memory, the OS's file cache in it included, and
# the buffer pool shrinks to fit, so that data larger than that is read from the disk.
set -euo pipefail # no -x: the script holds the password
shutdown -h +${lifetime}
dev=/dev/$(lsblk -dno NAME,MODEL | awk '/Instance Storage/ {print $1; exit}')
mkfs.ext4 -F "$dev"
mkdir -p /data && mount "$dev" /data
apt-get update && apt-get install -y docker.io
%{ if db_memory_mb > 0 ~}
limit="--memory=${db_memory_mb}m"
pg="-c shared_buffers=${floor(db_memory_mb / 4)}MB -c effective_cache_size=${floor(db_memory_mb / 2)}MB"
pool="--innodb-buffer-pool-size=${floor(db_memory_mb * 3 / 8)}M"
%{ else ~}
limit=""
pg="-c shared_buffers=8GB -c effective_cache_size=24GB"
pool="--innodb-buffer-pool-size=20G"
%{ endif ~}
case "${engine}" in
  postgresql)
    docker run -d --name db --network host $limit -v /data/pg:/var/lib/postgresql/data \
      -e POSTGRES_PASSWORD='${password}' --shm-size=9g postgres:16 \
      $pg -c work_mem=64MB \
      -c maintenance_work_mem=1GB -c random_page_cost=1.1 ;;
  mysql)
    docker run -d --name db --network host $limit -v /data/mysql:/var/lib/mysql \
      -e MYSQL_ROOT_PASSWORD='${password}' mysql:8.4 \
      $pool --innodb-redo-log-capacity=4294967296 ;;
  mariadb)
    docker run -d --name db --network host $limit -v /data/mariadb:/var/lib/mysql \
      -e MARIADB_ROOT_PASSWORD='${password}' mariadb:11.4 \
      $pool --innodb-log-file-size=4294967296 ;;
  oracle)
    mkdir -p /data/oracle && chown 54321:54321 /data/oracle
%{ if oracle_image == "" ~}
    # Oracle Free, the tests' database: the product caps it at 2 CPUs and 2 GB, so no limit here
    docker run -d --name db --network host -v /data/oracle:/opt/oracle/oradata \
      -e ORACLE_PASSWORD='${password}' gvenzl/oracle-free:23-slim ;;
%{ else ~}
    echo '${registry_token}' | docker login container-registry.oracle.com -u '${registry_user}' --password-stdin
    # no limit: an SGA of 16 GB is the image's minimum here
    docker run -d --name db --network host -v /data/oracle:/opt/oracle/oradata \
      -e ORACLE_PWD='${password}' -e INIT_SGA_SIZE=16384 -e INIT_PGA_SIZE=4096 \
      --shm-size=17g '${oracle_image}' ;;
%{ endif ~}
esac
